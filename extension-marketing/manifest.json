{
  "manifest_version": 3,
  "name": "EduCRM Marketing",
  "short_name": "EduCRM Mkt",
  "version": "1.0.0",
  "description": "Переносить список клієнтів маркетингового заходу з робочої CRM у Відкритий захід EduCRM в один клік.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://crm.itstep.org/*",
    "https://vadympavlina.github.io/EduCRM/*",
    "https://educrm-85756-default-rtdb.firebaseio.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.itstep.org/*"
      ],
      "js": [
        "shared.js",
        "event-import.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vadympavlina.github.io/EduCRM/*"
      ],
      "js": [
        "edu-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "EduCRM Marketing — відкрийте «Список клієнтів» заходу в CRM",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
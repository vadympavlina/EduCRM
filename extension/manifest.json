{
  "manifest_version": 3,
  "name": "EduCRM — помічник для робочої CRM",
  "short_name": "EduCRM",
  "version": "2.3.0",
  "description": "Кнопка EduCRM на картці клієнта і перенесення списку заходу у Відкритий захід — з робочої CRM в один клік.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://crm.itstep.org/*",
    "https://vadympavlina.github.io/EduCRM/*",
    "https://educrm-85756-default-rtdb.firebaseio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://crm.itstep.org/*"
      ],
      "js": [
        "shared.js",
        "crm-watcher.js",
        "event-import.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vadympavlina.github.io/EduCRM/*"
      ],
      "js": [
        "edu-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EduCRM",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}